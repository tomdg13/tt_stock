import 'package:flutter/material.dart';
import 'api.dart';
import 'lao.dart';
import 'theme.dart';
import 'widgets.dart';

// ------------------------------------------------------------- shared bits
class Line {
  final Map<String, dynamic> product;
  int qty;
  Line(this.product, this.qty);
}

/// Product search sheet; returns the chosen product map.
Future<Map<String, dynamic>?> pickProduct(BuildContext context) =>
    showModalBottomSheet<Map<String, dynamic>>(
      context: context,
      isScrollControlled: true,
      builder: (_) => const _ProductPicker(),
    );

class _ProductPicker extends StatefulWidget {
  const _ProductPicker();
  @override
  State<_ProductPicker> createState() => _ProductPickerState();
}

class _ProductPickerState extends State<_ProductPicker> {
  final _q = TextEditingController();
  late Future<dynamic> _f = _load();
  Future<dynamic> _load() =>
      Api.get('/products?limit=30&active=1&q=${Uri.encodeQueryComponent(_q.text.trim())}');

  @override
  Widget build(BuildContext context) {
    final p = pal(context);
    return Padding(
      padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom),
      child: SizedBox(
        height: MediaQuery.of(context).size.height * 0.7,
        child: Column(children: [
          Padding(
            padding: const EdgeInsets.all(12),
            child: TextField(
              controller: _q,
              autofocus: true,
              textInputAction: TextInputAction.search,
              onSubmitted: (_) => setState(() { _f = _load(); }),
              decoration: const InputDecoration(hintText: 'ຄົ້ນຫາສິນຄ້າ', prefixIcon: Icon(Icons.search)),
            ),
          ),
          Expanded(
            child: FutureBuilder(
              future: _f,
              builder: (c, s) {
                if (s.connectionState != ConnectionState.done) {
                  return const Center(child: CircularProgressIndicator());
                }
                if (s.hasError) return ErrorView(s.error!, () => setState(() { _f = _load(); }));
                final items = asList(s.data);
                return ListView.builder(
                  itemCount: items.length,
                  itemBuilder: (_, i) => ListTile(
                    title: Text(pick(items[i], ['name', 'productName', 'id'])),
                    subtitle: Text(pick(items[i], ['brandName', 'typeName', 'code']),
                        style: TextStyle(color: p.mut)),
                    onTap: () => Navigator.pop(context, items[i]),
                  ),
                );
              },
            ),
          ),
        ]),
      ),
    );
  }
}

/// "Items" block with add / +- / remove; the parent owns [lines].
class LineEditor extends StatefulWidget {
  final List<Line> lines;
  const LineEditor(this.lines, {super.key});
  @override
  State<LineEditor> createState() => _LineEditorState();
}

class _LineEditorState extends State<LineEditor> {
  @override
  Widget build(BuildContext context) {
    final p = pal(context);
    final lines = widget.lines;
    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
      Row(children: [
        const Text('ສິນຄ້າ', style: TextStyle(fontWeight: FontWeight.w600)),
        const Spacer(),
        TextButton.icon(
          onPressed: () async {
            final prod = await pickProduct(context);
            if (prod != null) setState(() { lines.add(Line(prod, 1)); });
          },
          icon: const Icon(Icons.add),
          label: const Text('ເພີ່ມສິນຄ້າ'),
        ),
      ]),
      if (lines.isEmpty) Text('ຍັງບໍ່ໄດ້ເລືອກສິນຄ້າ', style: TextStyle(color: p.mut)),
      for (var i = 0; i < lines.length; i++)
        cardBox(
          context,
          margin: const EdgeInsets.only(top: 6),
          color: p.bg,
          radius: 8,
          child: ListTile(
            dense: true,
            title: Text(pick(lines[i].product, ['name', 'productName', 'id'])),
            subtitle: Text(pick(lines[i].product, ['brandName', 'typeName']),
                style: TextStyle(color: p.mut)),
            trailing: Row(mainAxisSize: MainAxisSize.min, children: [
              IconButton(
                  icon: const Icon(Icons.remove_circle_outline),
                  onPressed: lines[i].qty > 1 ? () => setState(() { lines[i].qty--; }) : null),
              Text('${lines[i].qty}', style: const TextStyle(fontWeight: FontWeight.bold)),
              IconButton(
                  icon: const Icon(Icons.add_circle_outline),
                  onPressed: () => setState(() { lines[i].qty++; })),
              IconButton(
                  icon: Icon(Icons.delete_outline, color: p.bad),
                  onPressed: () => setState(() { lines.removeAt(i); })),
            ]),
          ),
        ),
    ]);
  }
}

Widget moveRow(BuildContext c, Map<String, dynamic> m) {
  final p = pal(c);
  final t = pick(m, ['type', 'movementType']);
  final info = moveTypes[t];
  final q = num0(m['qty'] ?? m['quantity']);
  final meta = [
    pick(m, ['branchName', 'branchId']),
    pick(m, ['ref', 'refNo', 'docNo']),
    pick(m, ['createdAt', 'time', 'ts', 'movedAt']),
  ].where((e) => e.isNotEmpty).join(' · ');
  return Container(
    padding: const EdgeInsets.symmetric(vertical: 9),
    decoration: BoxDecoration(border: Border(bottom: BorderSide(color: p.bd))),
    child: Row(children: [
      Tag(info?[0] ?? t, info?[1] ?? ''),
      const SizedBox(width: 10),
      Expanded(
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text(pick(m, ['productName', 'name', 'productId'])),
          if (meta.isNotEmpty) Text(meta, style: TextStyle(color: p.mut, fontSize: 12)),
        ]),
      ),
      Text('${q > 0 ? '+' : ''}${fmtNum(q)}',
          style: TextStyle(fontWeight: FontWeight.w700, color: q > 0 ? p.ok : p.bad)),
    ]),
  );
}

Widget futureBlock(Future<dynamic> f, VoidCallback retry, Widget Function(dynamic) build) =>
    FutureBuilder(
      future: f,
      builder: (c, s) {
        if (s.connectionState != ConnectionState.done) {
          return const Padding(padding: EdgeInsets.all(24), child: Center(child: CircularProgressIndicator()));
        }
        if (s.hasError) return ErrorView(s.error!, retry);
        return build(s.data);
      },
    );

Widget branchDropdown(String label, List<Map<String, dynamic>> branches, dynamic value,
        ValueChanged<dynamic> onChanged) =>
    DropdownButtonFormField<dynamic>(
      key: ValueKey('$label-${branches.length}-$value'),
      initialValue: branches.any((b) => b['id'] == value) ? value : null,
      isExpanded: true,
      decoration: InputDecoration(labelText: label),
      items: [
        for (final b in branches)
          DropdownMenuItem(value: b['id'], child: Text(pick(b, ['name', 'branchName', 'id']))),
      ],
      onChanged: onChanged,
    );

Widget saveButton(String text, bool busy, VoidCallback onTap) => SizedBox(
      width: double.infinity,
      height: 48,
      child: FilledButton(
        onPressed: busy ? null : onTap,
        child: busy
            ? const SizedBox(width: 20, height: 20, child: CircularProgressIndicator(strokeWidth: 2))
            : Text(text),
      ),
    );

// ---------------------------------------------------------------- Stock
class StockScreen extends StatefulWidget {
  const StockScreen({super.key});
  @override
  State<StockScreen> createState() => _StockScreenState();
}

class _StockScreenState extends State<StockScreen> {
  final _q = TextEditingController();
  bool _low = false;
  late Future<dynamic> _f = _load();

  Future<dynamic> _load() {
    final parts = [
      if (_q.text.trim().isNotEmpty) 'q=${Uri.encodeQueryComponent(_q.text.trim())}',
      if (_low) 'low=1',
    ];
    return Api.get('/stock/balances${parts.isEmpty ? '' : '?${parts.join('&')}'}');
  }

  void _reload() => setState(() { _f = _load(); });

  @override
  Widget build(BuildContext context) {
    final p = pal(context);
    return Column(children: [
      Padding(
        padding: const EdgeInsets.fromLTRB(16, 12, 16, 4),
        child: Row(children: [
          Expanded(
            child: TextField(
              controller: _q,
              textInputAction: TextInputAction.search,
              onSubmitted: (_) => _reload(),
              decoration: const InputDecoration(hintText: 'ຄົ້ນຫາສິນຄ້າ', prefixIcon: Icon(Icons.search)),
            ),
          ),
          const SizedBox(width: 8),
          FilterChip(
            label: const Text('ໃກ້ໝົດ'),
            selected: _low,
            onSelected: (v) {
              _low = v;
              _reload();
            },
          ),
        ]),
      ),
      Expanded(
        child: FutureBuilder(
          future: _f,
          builder: (c, s) {
            if (s.connectionState != ConnectionState.done) {
              return const Center(child: CircularProgressIndicator());
            }
            if (s.hasError) return ErrorView(s.error!, _reload);
            final rows = asList(s.data);
            final groups = <String, List<Map<String, dynamic>>>{};
            for (final r in rows) {
              groups.putIfAbsent(pick(r, ['productId', 'productName', 'name', 'id']), () => []).add(r);
            }
            return RefreshIndicator(
              onRefresh: () async => _reload(),
              child: groups.isEmpty
                  ? ListView(children: [
                      const SizedBox(height: 120),
                      Center(child: Text('ຍັງບໍ່ມີລາຍການ', style: TextStyle(color: p.mut))),
                    ])
                  : ListView(padding: const EdgeInsets.fromLTRB(16, 8, 16, 16), children: [
                      for (final g in groups.values) _productCard(context, g),
                      Text('ແຖບສີແດງ = ຕ່ຳກວ່າຈຳນວນຕ່ຳສຸດ', style: TextStyle(color: p.mut, fontSize: 13)),
                    ]),
            );
          },
        ),
      ),
    ]);
  }

  Widget _productCard(BuildContext context, List<Map<String, dynamic>> g) {
    final p = pal(context);
    final f = g.first;
    const qk = ['qty', 'quantity', 'balance', 'onHand'];
    const mk = ['minQty', 'min', 'minStock', 'reorderLevel'];
    final total = g.fold<double>(0, (a, r) => a + num0(pick(r, qk)));
    final meta = ['typeName', 'brandName', 'modelName', 'binCode', 'unit']
        .map((k) => pick(f, [k]))
        .where((e) => e.isNotEmpty)
        .join(' / ');
    return AppCard(
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Expanded(
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text(pick(f, ['productName', 'name', 'productId']),
                  style: const TextStyle(fontWeight: FontWeight.w600)),
              if (meta.isNotEmpty) Text(meta, style: TextStyle(color: p.mut, fontSize: 13)),
            ]),
          ),
          Column(crossAxisAlignment: CrossAxisAlignment.end, children: [
            Text(fmtNum(total), style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w700)),
            Text('ລວມ', style: TextStyle(color: p.mut, fontSize: 12)),
          ]),
        ]),
        const SizedBox(height: 8),
        for (final r in g) _branchRow(context, r, qk, mk),
      ]),
    );
  }

  Widget _branchRow(BuildContext context, Map<String, dynamic> r, List<String> qk, List<String> mk) {
    final p = pal(context);
    final q = num0(pick(r, qk)), min = num0(pick(r, mk));
    final low = min > 0 && q < min;
    final frac = min > 0 ? (q / (min * 4)).clamp(0.0, 1.0) : (q > 0 ? 1.0 : 0.0);
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 4),
      child: Row(children: [
        Expanded(flex: 4, child: Text(pick(r, ['branchName', 'branchId']), style: const TextStyle(fontSize: 14))),
        Expanded(
          flex: 4,
          child: ClipRRect(
            borderRadius: BorderRadius.circular(3),
            child: LinearProgressIndicator(
              value: frac.toDouble(), minHeight: 5, backgroundColor: p.bd, color: low ? p.bad : p.bar),
          ),
        ),
        SizedBox(
          width: 52,
          child: Text(fmtNum(q),
              textAlign: TextAlign.end,
              style: TextStyle(fontWeight: FontWeight.w700, color: low ? p.bad : p.tx)),
        ),
      ]),
    );
  }
}

// -------------------------------------------------------------- History
class HistoryScreen extends StatefulWidget {
  const HistoryScreen({super.key});
  @override
  State<HistoryScreen> createState() => _HistoryScreenState();
}

class _HistoryScreenState extends State<HistoryScreen> {
  dynamic _prod = 'all';
  late final Future<dynamic> _prods = Api.get('/products?limit=200');
  late Future<dynamic> _mv = _loadMv();
  Future<dynamic>? _bal;

  Future<dynamic> _loadMv() =>
      Api.get('/stock/movements${_prod == 'all' ? '' : '?productId=$_prod'}');

  void _pick(dynamic v) => setState(() {
        _prod = v ?? 'all';
        _mv = _loadMv();
        _bal = _prod == 'all' ? null : Api.get('/stock/balances?productId=$_prod');
      });

  @override
  Widget build(BuildContext context) {
    return RefreshIndicator(
      onRefresh: () async => _pick(_prod),
      child: ListView(padding: const EdgeInsets.all(16), children: [
        AppCard(
          title: 'ສິນຄ້ານີ້ໄປຢູ່ໃສ? (ປະຫວັດການເຄື່ອນໄຫວ)',
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            FutureBuilder(
              future: _prods,
              builder: (c, s) {
                final items = s.hasData ? asList(s.data) : <Map<String, dynamic>>[];
                return DropdownButtonFormField<dynamic>(
                  initialValue: _prod,
                  isExpanded: true,
                  decoration: const InputDecoration(labelText: 'ເລືອກສິນຄ້າ'),
                  items: [
                    const DropdownMenuItem(value: 'all', child: Text('ທັງໝົດ')),
                    for (final it in items)
                      DropdownMenuItem(value: it['id'], child: Text(pick(it, ['name', 'productName', 'id']))),
                  ],
                  onChanged: _pick,
                );
              },
            ),
            if (_bal != null)
              futureBlock(_bal!, () => _pick(_prod), (d) {
                final rows = asList(d);
                return Padding(
                  padding: const EdgeInsets.only(top: 12),
                  child: Wrap(spacing: 8, runSpacing: 8, children: [
                    for (final r in rows)
                      InfoChip(pick(r, ['branchName', 'branchId']),
                          fmtNum(num0(pick(r, ['qty', 'quantity', 'balance'])))),
                  ]),
                );
              }),
            const SizedBox(height: 8),
            futureBlock(_mv, () => _pick(_prod), (d) {
              final rows = asList(d);
              if (rows.isEmpty) return const Padding(padding: EdgeInsets.all(8), child: Text('ຍັງບໍ່ມີລາຍການ'));
              return Column(children: [for (final m in rows.take(40)) moveRow(context, m)]);
            }),
          ]),
        ),
      ]),
    );
  }
}

// ----------------------------------------------------- Receive / Issue
class StockFormPage extends StatefulWidget {
  final bool issue;
  const StockFormPage({super.key, required this.issue});
  @override
  State<StockFormPage> createState() => _StockFormPageState();
}

class _StockFormPageState extends State<StockFormPage> {
  final _note = TextEditingController();
  final _lines = <Line>[];
  List<Map<String, dynamic>> _branches = [];
  dynamic _branchId;
  String _reason = 'sale';
  bool _busy = false;
  String? _error;
  late Future<dynamic> _recent = Api.get('/stock/movements');

  @override
  void initState() {
    super.initState();
    loadBranches().then((b) {
      if (!mounted) return;
      setState(() {
        _branches = b;
        final mine = Api.user?['branchId'];
        if (b.any((x) => x['id'] == mine)) _branchId = mine;
      });
    }).catchError((_) {});
  }

  Future<void> _submit() async {
    if (_branchId == null) return setState(() { _error = 'ເລືອກສາຂາ'; });
    if (_lines.isEmpty) return setState(() { _error = 'ເພີ່ມສິນຄ້າຢ່າງນ້ອຍ 1 ລາຍການ'; });
    setState(() {
      _busy = true;
      _error = null;
    });
    try {
      // NOTE: field names are inferred from the route list. Check them
      // against the DTOs of POST /stock/receive and /stock/issue.
      final body = {
        'branchId': _branchId,
        'items': [for (final l in _lines) {'productId': l.product['id'], 'qty': l.qty}],
        if (_note.text.trim().isNotEmpty) 'note': _note.text.trim(),
        if (widget.issue) 'type': _reason,
      };
      await Api.post(widget.issue ? '/stock/issue' : '/stock/receive', body);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('ບັນທຶກແລ້ວ')));
      setState(() {
        _lines.clear();
        _note.clear();
        _recent = Api.get('/stock/movements');
      });
    } catch (e) {
      if (mounted) setState(() { _error = '$e'; });
    } finally {
      if (mounted) setState(() { _busy = false; });
    }
  }

  @override
  Widget build(BuildContext context) {
    final p = pal(context);
    return ListView(padding: const EdgeInsets.all(16), children: [
      AppCard(
        title: widget.issue ? 'ເອົາສິນຄ້າອອກ' : 'ຮັບເຄື່ອງເຂົ້າ (GRN)',
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          branchDropdown('ສາຂາ', _branches, _branchId, (v) => setState(() { _branchId = v; })),
          if (widget.issue) ...[
            const SizedBox(height: 12),
            DropdownButtonFormField<String>(
              initialValue: _reason,
              decoration: const InputDecoration(labelText: 'ເຫດຜົນ'),
              items: [for (final e in reasons.entries) DropdownMenuItem(value: e.key, child: Text(e.value))],
              onChanged: (v) => setState(() { _reason = v ?? 'sale'; }),
            ),
          ],
          const SizedBox(height: 12),
          TextField(controller: _note, decoration: const InputDecoration(labelText: 'ໝາຍເຫດ (ບໍ່ບັງຄັບ)')),
          const SizedBox(height: 12),
          LineEditor(_lines),
          if (_error != null)
            Padding(padding: const EdgeInsets.only(top: 8), child: Text(_error!, style: TextStyle(color: p.bad))),
          const SizedBox(height: 14),
          saveButton(widget.issue ? 'ບັນທຶກເອົາອອກ' : 'ບັນທຶກຮັບເຂົ້າ', _busy, _submit),
          const SizedBox(height: 6),
          Text(widget.issue ? 'ຖ້າຈຳນວນຫຼາຍກວ່າສະຕັອກ ລະບົບຈະບໍ່ໃຫ້ບັນທຶກ' : '',
              style: TextStyle(color: p.mut, fontSize: 13)),
        ]),
      ),
      AppCard(
        title: widget.issue ? 'ເອົາອອກລ່າສຸດ' : 'ຮັບເຂົ້າລ່າສຸດ',
        child: futureBlock(_recent, () => setState(() { _recent = Api.get('/stock/movements'); }), (d) {
          final all = asList(d);
          var rows = <Map<String, dynamic>>[];
          if (widget.issue) {
            rows = all.where((m) => pick(m, ['type', 'movementType']).contains('issue')).toList();
          } else {
            rows = all.where((m) {
              final t = pick(m, ['type', 'movementType']);
              return t.contains('purchase') || t.contains('receive');
            }).toList();
          }
          if (rows.isEmpty) rows = all;
          if (rows.isEmpty) return Text('ຍັງບໍ່ມີລາຍການ', style: TextStyle(color: p.mut));
          return Column(children: [for (final m in rows.take(5)) moveRow(context, m)]);
        }),
      ),
    ]);
  }
}

// -------------------------------------------------------------- Transfer
class TransferScreen extends StatefulWidget {
  const TransferScreen({super.key});
  @override
  State<TransferScreen> createState() => _TransferScreenState();
}

class _TransferScreenState extends State<TransferScreen> {
  final _lines = <Line>[];
  List<Map<String, dynamic>> _branches = [];
  dynamic _from, _to;
  bool _busy = false;
  String? _error;
  late Future<dynamic> _list = Api.get('/stock/transfers');

  @override
  void initState() {
    super.initState();
    loadBranches().then((b) {
      if (!mounted) return;
      setState(() {
        _branches = b;
        final mine = Api.user?['branchId'];
        if (b.any((x) => x['id'] == mine)) _from = mine;
      });
    }).catchError((_) {});
  }

  void _reload() => setState(() { _list = Api.get('/stock/transfers'); });

  Future<void> _send() async {
    if (_from == null || _to == null) return setState(() { _error = 'ເລືອກສາຂາຕົ້ນທາງ ແລະ ປາຍທາງ'; });
    if (_from == _to) return setState(() { _error = 'ສາຂາຕົ້ນທາງ ແລະ ປາຍທາງຕ້ອງຕ່າງກັນ'; });
    if (_lines.isEmpty) return setState(() { _error = 'ເພີ່ມສິນຄ້າຢ່າງນ້ອຍ 1 ລາຍການ'; });
    setState(() {
      _busy = true;
      _error = null;
    });
    try {
      // NOTE: body field names are inferred; check against POST /stock/transfers.
      await Api.post('/stock/transfers', {
        'fromBranchId': _from,
        'toBranchId': _to,
        'items': [for (final l in _lines) {'productId': l.product['id'], 'qty': l.qty}],
      });
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('ສົ່ງໂອນແລ້ວ')));
      setState(_lines.clear);
      _reload();
    } catch (e) {
      if (mounted) setState(() { _error = '$e'; });
    } finally {
      if (mounted) setState(() { _busy = false; });
    }
  }

  Future<void> _act(Map<String, dynamic> t, String action, String done) async {
    try {
      await Api.post('/stock/transfers/${t['id']}/$action', {});
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(done)));
      _reload();
    } catch (e) {
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('$e')));
    }
  }

  @override
  Widget build(BuildContext context) {
    final p = pal(context);
    return RefreshIndicator(
      onRefresh: () async => _reload(),
      child: ListView(padding: const EdgeInsets.all(16), children: [
        if (Api.can('TRANSFER_SEND'))
          AppCard(
            title: 'ໂອນສິນຄ້າລະຫວ່າງສາຂາ',
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              branchDropdown('ຈາກສາຂາ', _branches, _from, (v) => setState(() { _from = v; })),
              const SizedBox(height: 12),
              branchDropdown('ໄປສາຂາ', _branches, _to, (v) => setState(() { _to = v; })),
              const SizedBox(height: 12),
              LineEditor(_lines),
              if (_error != null)
                Padding(padding: const EdgeInsets.only(top: 8), child: Text(_error!, style: TextStyle(color: p.bad))),
              const SizedBox(height: 14),
              saveButton('ສົ່ງໂອນ', _busy, _send),
            ]),
          ),
        AppCard(
          title: 'ໃບໂອນ',
          child: futureBlock(_list, _reload, (d) {
            final rows = asList(d);
            if (rows.isEmpty) return Text('ຍັງບໍ່ມີລາຍການ', style: TextStyle(color: p.mut));
            return Column(children: [for (final t in rows) _transferRow(context, t)]);
          }),
        ),
      ]),
    );
  }

  Widget _transferRow(BuildContext context, Map<String, dynamic> t) {
    final p = pal(context);
    final st = pick(t, ['status', 'state']);
    final info = transferStatus[st];
    final items = t['items'] is List ? asList(t['items']) : <Map<String, dynamic>>[];
    final lines = items.isEmpty
        ? pick(t, ['productName'])
        : items.map((i) => '${pick(i, ['productName', 'name', 'productId'])} × ${fmtNum(num0(i['qty'] ?? i['quantity']))}').join('\n');
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 10),
      decoration: BoxDecoration(border: Border(bottom: BorderSide(color: p.bd))),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Expanded(child: Text(pick(t, ['ref', 'docNo', 'id']), style: const TextStyle(fontWeight: FontWeight.w600))),
          Tag(info?[0] ?? st, info?[1] ?? kindOf(st)),
        ]),
        Text('${pick(t, ['fromBranchName', 'fromBranchId'])} → ${pick(t, ['toBranchName', 'toBranchId'])}',
            style: TextStyle(color: p.mut, fontSize: 13)),
        if (lines.isNotEmpty) Padding(padding: const EdgeInsets.only(top: 4), child: Text(lines)),
        if (st == 'in_transit')
          Padding(
            padding: const EdgeInsets.only(top: 8),
            child: Wrap(spacing: 8, children: [
              if (Api.can('TRANSFER_RECEIVE'))
                FilledButton(onPressed: () => _act(t, 'receive', 'ຮັບເຄື່ອງແລ້ວ'), child: const Text('ຮັບເຄື່ອງ')),
              if (Api.can('TRANSFER_SEND'))
                OutlinedButton(onPressed: () => _act(t, 'cancel', 'ຍົກເລີກແລ້ວ'), child: const Text('ຍົກເລີກ')),
            ]),
          ),
      ]),
    );
  }
}
